{
    "name": "huseyinfiliz/traderfeedback",
    "description": "A comprehensive trader feedback system for Flarum",
    "type": "flarum-extension",
    "keywords": ["flarum", "trader", "feedback", "rating", "reputation"],
    "license": "MIT",
    "authors": [
        {
            "name": "Hüseyin Filiz",
            "email": "mysuperuser01@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/huseyinfiliz/flarum-trader-feedback",
    "support": {
        "issues": "https://github.com/huseyinfiliz/flarum-trader-feedback/issues",
        "source": "https://github.com/huseyinfiliz/flarum-trader-feedback"
    },
    "require": {
        "flarum/core": "^1.2.0"
    },
    "autoload": {
        "psr-4": {
            "HuseyinFiliz\\TraderFeedback\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Trader Feedback",
            "category": "feature",
            "icon": {
                "name": "fas fa-exchange-alt",
                "backgroundColor": "#3498db",
                "color": "#fff"
            }
        }
    },
    "flagrow": {
        "discuss": "https://discuss.flarum.org/d/38253-trader-feedback-buyselltrade-rating-extension/"
    },
    "flarum-cli": {
        "modules": {
            "githubActions": true,
            "backendTesting": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HuseyinFiliz\\TraderFeedback\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "flarum/phpstan": "*",
        "flarum/testing": "^1.0.0"
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    }
}
